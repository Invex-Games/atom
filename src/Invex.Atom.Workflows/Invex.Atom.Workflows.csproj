    </Compile>
    <Compile Update="Workflows\Expressions\WorkflowExpression.Functions.cs">
      <DependentUpon>WorkflowExpression.cs</DependentUpon>
    </Compile>
    <Compile Update="Workflows\Expressions\WorkflowExpression.LogicOperators.cs">
      <DependentUpon>WorkflowExpression.cs</DependentUpon>
    </Compile>
    <Compile Update="Workflows\Expressions\WorkflowExpression.WorkflowRun.cs">
      <DependentUpon>WorkflowExpression.cs</DependentUpon>
    </Compile>
  </ItemGroup>

